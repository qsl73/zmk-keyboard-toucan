        bindings = <&world_quotes_left_curly>, <&world_quotes_left_RCTL>;
        mods = <(MOD_RCTL|MOD_RSFT)>;
    };
    world_quotes_left_RCTL: world_quotes_left_RCTL {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_left_low>, <&world_quotes_left_grave>;
        mods = <(MOD_RSFT)>;
    };
    world_quotes_right_base: world_quotes_right_base {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_right_angle>, <&world_quotes_right_LALT>;
        mods = <(MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_quotes_right_LALT: world_quotes_right_LALT {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_right_corner1>, <&world_quotes_right_RALT>;
        mods = <(MOD_RALT|MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_quotes_right_RALT: world_quotes_right_RALT {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_right_corner2>, <&world_quotes_right_LCTL>;
        mods = <(MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_quotes_right_LCTL: world_quotes_right_LCTL {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_right_curly>, <&world_quotes_right_RCTL>;
        mods = <(MOD_RCTL|MOD_RSFT)>;
    };
    world_quotes_right_RCTL: world_quotes_right_RCTL {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_quotes_right_low>, <&world_quotes_right_grave>;
        mods = <(MOD_RSFT)>;
    };
    world_currency_base: world_currency_base {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_currency_dollar>, <&world_currency_LALT>;
        mods = <(MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_currency_LALT: world_currency_LALT {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_currency_yen>, <&world_currency_RALT>;
        mods = <(MOD_RALT|MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_currency_RALT: world_currency_RALT {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_currency_won>, <&world_currency_LCTL>;
        mods = <(MOD_LCTL|MOD_RCTL|MOD_RSFT)>;
    };
    world_currency_LCTL: world_currency_LCTL {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_currency_euro>, <&world_currency_RCTL>;
        mods = <(MOD_RCTL|MOD_RSFT)>;
    };
    world_currency_RCTL: world_currency_RCTL {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_currency_pound>, <&world_currency_generic>;
        mods = <(MOD_RSFT)>;
    };

    // --- ajout Toucan : ligature œ/Œ (absente de world.yaml v38) ---
    UNICODE(world_oe_lower_macro, /* œ */
        #ifdef WORLD_USE_COMPOSE
        #define WORLD_USE_COMPOSE_FOR_world_oe_lower
        COMPOSE_SEQ_MACOS(&kp LA(Q))
        #else
        UNICODE_SEQ_MACOS(&kp N0 &kp N1 &kp N5 &kp N3)
        #endif
    )
    world_oe_lower: world_oe_lower {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_oe_lower_macro>, <&world_oe_lower_macro>;
        mods = <(~(
#ifdef WORLD_USE_COMPOSE_FOR_world_oe_lower
COMPOSE_MORPH_MODS
#else
UNICODE_MORPH_MODS
#endif
))>;
    };
    UNICODE(world_oe_upper_macro, /* Œ */
        #ifdef WORLD_USE_COMPOSE
        #define WORLD_USE_COMPOSE_FOR_world_oe_upper
        COMPOSE_SEQ_MACOS(&kp LA(LS(Q)))
        #else
        UNICODE_SEQ_MACOS(&kp N0 &kp N1 &kp N5 &kp N2)
        #endif
    )
    world_oe_upper: world_oe_upper {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_oe_upper_macro>, <&world_oe_upper_macro>;
        mods = <(~(
#ifdef WORLD_USE_COMPOSE_FOR_world_oe_upper
COMPOSE_MORPH_MODS
#else
UNICODE_MORPH_MODS
#endif
))>;
    };
    world_oe: world_oe {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&world_oe_lower>, <&world_oe_upper>;
        mods = <MOD_LSFT>;
    };

    };

    macros {
        // Mod+Tab : garder la touche enfoncée laisse le sélecteur ouvert
        mod_tab: mod_tab_switcher {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                ;
        };
        mod_tab_chord: mod_tab_switcher_chord {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_2to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_press &mod_tab MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mod_tab MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        ZMK_MACRO(select_word_right,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _W(RIGHT) &kp _W(LEFT) &kp _W(LS(RIGHT))>;
        )
        ZMK_MACRO(select_word_left,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _W(LEFT) &kp _W(RIGHT) &kp _W(LS(LEFT))>;
        )
        ZMK_MACRO(extend_word_right,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _W(LS(RIGHT))>;
        )
        ZMK_MACRO(extend_word_left,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _W(LS(LEFT))>;
        )
        ZMK_MACRO(select_line_right,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _HOME &kp LS(_END)>;
        )
        ZMK_MACRO(select_line_left,
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp _END &kp LS(_HOME)>;
        )
    };

    combos {
        compatible = "zmk,combos";

        // ⌫ + Ctrl+Tab (pouces gauches milieu + intérieur) : Ctrl+Tab maintenu
        combo_ctrl_tab_switcher {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <37 38>;
            bindings = <&mod_tab_chord LCTL CURSOR>;
            layers = <BASE>;
        };
        // Échap + ⌫ (pouces gauches extérieur + milieu) : Cmd+Tab maintenu
        combo_cmd_tab_switcher {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <36 37>;
            bindings = <&mod_tab_chord _A_TAB CURSOR>;
            layers = <BASE>;
        };
        // Tab + Espace (pouces droits intérieur + milieu) : couche WORLD
        combo_world_layer {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <39 40>;
            bindings = <&mo WORLD>;
            layers = <BASE>;
        };
        // Espace + Entrée : Hyper (Cmd+Option+Ctrl+Maj) pour un seul raccourci
        combo_sticky_hyper {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <40 41>;
            bindings = <&sk LG(LA(LC(LSHFT)))>;
            layers = <BASE>;
        };
        // ⌫ + F / Espace + J : Maj pour une seule lettre
        combo_sticky_shift_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <37 16>;
            bindings = <&sk LSHFT>;
            layers = <BASE>;
        };
        combo_sticky_shift_right {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <40 19>;
            bindings = <&sk LSHFT>;
            layers = <BASE>;
        };
        // Échap + F / Entrée + J : mot en majuscules
        combo_caps_word_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <36 16>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };
        combo_caps_word_right {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <41 19>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_base {
            display-name = "BASE";
            bindings = <
                &kp GRAVE   &kp Q            &hm RING2_MOD W  &kp E            &kp R            &kp T    &kp Y  &kp U            &kp I            &hm RING2_MOD O  &kp P               &kp MINUS
                &caps_word  &hm PINKY_MOD A  &hm RING1_MOD S  &hm MIDDY_MOD D  &hs INDEX_MOD F  &kp G    &kp H  &hs INDEX_MOD J  &hm MIDDY_MOD K  &hm RING1_MOD L  &hm PINKY_MOD SEMI  &kp SQT
                &sk LSHFT   &kp Z            &kp X            &kp C            &kp V            &kp B    &kp N  &kp M            &kp COMMA        &kp DOT          &kp FSLH            &sk RSHFT
                                                              &thumb FUNCTION ESC  &thumb CURSOR BSPC  &thumb NUMBER LC(TAB)    &thumb MOUSE TAB  &space SYMBOL SPACE  &thumb SYSTEM RET
            >;
        };

        layer_cursor {
            display-name = "CURS";
            bindings = <
                &mod_tab _A_TAB  &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &kp _CUT      &kp _CUT    &kp BSPC  &kp _UNDO  &kp _REDO  &sk LSHFT  &kp _C(K)
                &mod_tab LCTL    &kp PINKY_MOD  &kp RING1_MOD  &kp MIDDY_MOD  &kp INDEX_MOD  &kp _COPY     &kp _COPY   &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &kp _C(L)
                &kp TAB          &kp _C(A)      &select_line   &select_word   &kp _FIND      &kp _PASTE    &kp _PASTE  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &kp _C(J)
                                                               &mod_tab _A_TAB  &none  &mod_tab LCTL    &select_line  &select_word  &extend_word
            >;
        };

        layer_number {
            display-name = "NUM";
            bindings = <
                &kp D  &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &kp A    &kp PRCNT  &kp _N7  &kp _N8  &kp _N9  &kp COLON   &kp K
                &kp E  &kp PINKY_MOD  &kp RING1_MOD  &kp MIDDY_MOD  &kp INDEX_MOD  &kp B    &kp _PLUS  &kp _N4  &kp _N5  &kp _N6  &kp _MINUS  &kp J
                &kp F  &kp _C(A)      &select_line   &select_word   &kp UNDER      &kp C    &kp _STAR  &kp _N1  &kp _N2  &kp _N3  &kp _SLASH  &kp LS(G)
                                                     &none  &none  &none    &kp _DOT  &kp _N0  &kp _EQUAL
            >;
        };

        layer_function {
            display-name = "FUNC";
            bindings = <
                &kp C_BRI_UP  &sk LSHFT      &kp _REDO      &kp _UNDO      &kp BSPC       &kp C_PREV    &kp K_CALC      &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
                &kp CAPS      &kp PINKY_MOD  &kp RING1_MOD  &kp MIDDY_MOD  &kp INDEX_MOD  &kp C_NEXT    &kp K_WWW       &kp F4  &kp F5  &kp F6  &kp F11  &kp F14
                &kp C_BRI_DN  &kp _C(A)      &select_line   &select_word   &kp INS        &kp C_MUTE    &kp C_AL_FILES  &kp F1  &kp F2  &kp F3  &kp F12  &kp F15
                                                            &none  &none  &none    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP
            >;
        };

        layer_symbol {
            display-name = "SYM";
            bindings = <
                &kp EXCL   &kp LBRC   &kp SQT    &kp DQT    &kp RBRC  &kp QMARK    &kp AMPS  &kp INDEX_MOD  &kp MIDDY_MOD  &kp RING1_MOD  &kp PINKY_MOD  &kp AT
                &kp HASH   &kp CARET  &kp EQUAL  &kp UNDER  &kp DLLR  &kp STAR     &kp DOT   &kp BSPC       &kp TAB        &kp SPACE      &kp RET        &kp PLUS
                &kp TILDE  &kp LT     &kp PIPE   &kp MINUS  &kp GT    &kp FSLH     &kp DEL   &kp LPAR       &kp RPAR       &kp LBKT       &kp RBKT       &kp LS(TAB)
                                                 &kp BSLH  &kp PRCNT  &kp COLON    &none  &none  &none
            >;
        };

        layer_mouse {
            display-name = "MOUSE";
            bindings = <
                &none  &none     &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none    &mkp MCLK  &kp INDEX_MOD   &kp MIDDY_MOD  &kp RING1_MOD   &kp PINKY_MOD    &none
                &none  &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none    &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_UP   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
                &none  &mkp MB4  &mkp MB5        &msc SCRL_DOWN  &msc SCRL_UP     &none    &mkp RCLK  &msc SCRL_LEFT  &msc SCRL_UP   &msc SCRL_DOWN  &msc SCRL_RIGHT  &none
                                                 &mkp MCLK  &mkp LCLK  &mkp RCLK    &none  &none  &none
            >;
        };

        layer_system {
            display-name = "SYS";
            bindings = <
                &bootloader  &out OUT_USB  &out OUT_BLE  &none         &none         &studio_unlock    &none  &kp INDEX_MOD  &kp MIDDY_MOD  &kp RING1_MOD  &kp PINKY_MOD    &bootloader
                &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &none  &kp K_APP      &kp _LOCK      &kp _SLEEP     &kp _POWER       &none
                &sys_reset   &none         &none         &none         &none         &kp K_APP         &none  &none          &kp PSCRN      &kp SLCK       &kp PAUSE_BREAK  &sys_reset
                                                         &kp _LOCK  &kp PSCRN  &kp SLCK    &none  &none  &none
            >;
        };

        layer_world {
            display-name = "WORLD";
            bindings = <
                &world_section_sign   &world_degree_sign       &world_y_base        &world_o_base         &world_u_base             &world_oe           &none  &none      &kp LALT   &kp RALT   &none      &none
                &world_micro_sign     &world_consonants_base   &world_i_base        &world_e_base         &world_a_base             &world_o_ordinal    &none  &kp LSHFT  &kp LCTRL  &kp RCTRL  &kp RSHFT  &none
                &world_currency_base  &world_quotes_left_base  &world_exclaim_left  &world_question_left  &world_quotes_right_base  &world_a_ordinal    &none  &none      &none      &none      &none      &none
                                                                                    &none  &none  &none    &none  &none  &none
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };

    };
};

// Trackpad : défilement au lieu du pointeur quand la couche CURS est active
&glidepoint_listener {
    scroller {
        layers = <CURSOR>;
    };
};

